# ============================================
# AcousticBuild — .gitignore
# ============================================

# --- SEGURANÇA: Nunca versionar ---
*.env
.env
.env.*
# o modelo sem valores reais PRECISA ir para o repositório
!.env.example
!backend/.env.example
*.db
*.sqlite
*.sqlite3

# --- Python / Back-end ---
backend/venv/
backend/__pycache__/
backend/**/__pycache__/
backend/**/*.pyc
backend/**/*.pyo
backend/.pytest_cache/
backend/.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# --- Node / Front-end ---
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/.env
frontend/.env.*

# --- VSCode (cada dev tem o seu) ---
.vscode/
*.code-workspace

# --- Sistema Operacional ---
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# --- IDEs e Editores ---
.idea/
*.swp
*.swo
*~

# --- Configuração local de ferramentas de lint/tipagem ---
pyrightconfig.json
ruff.toml

# bilhete com a chave de produção: só local
CHAVE-PARA-VERCEL.txt
