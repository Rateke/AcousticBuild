# Modelo de configuração. Copie este arquivo para backend/.env e preencha.
# O .env real é bloqueado pelo .gitignore e nunca vai para o GitHub.

# OBRIGATÓRIA em produção. Assina os tokens de login: precisa ser um valor
# aleatório e secreto. Gere um novo com:
#     python -c "import secrets; print(secrets.token_hex(32))"
# Em desenvolvimento, se ficar vazia, o servidor sorteia uma chave temporária
# a cada execução (os logins caem a cada reinício).
SECRET_KEY=

# Banco de dados. Vazio = SQLite local (backend/acoust.db).
# Em produção, cole aqui a URL do Postgres (Neon, Supabase etc.).
DATABASE_URL=

# Envio do e-mail de recuperação de senha. Vazio = o link de recuperação é
# apenas impresso no terminal do servidor, sem envio de e-mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Endereço do site, usado para montar o link de recuperação no e-mail.
FRONTEND_URL=http://localhost:5173
